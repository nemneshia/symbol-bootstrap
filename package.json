{
  "name": "@nemneshia/symbol-bootstrap",
  "description": "Symbolネットワークを手軽に構築・設定・運用できるツール",
  "version": "3.0.0-alpha.0",
  "author": "ccHarvestasya <harvestasya84@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sb": "bin/run.js",
    "symbol-bootstrap": "bin/run.js"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "types": "lib/index.d.ts",
  "bugs": "https://github.com/nemneshia/symbol-bootstrap/issues",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "/config",
    "/presets",
    "/bin",
    "/lib",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/nemneshia/symbol-bootstrap",
  "oclif": {
    "bin": "symbol-bootstrap",
    "helpClass": "./lib/help",
    "commands": "./lib/commands",
    "plugins": [
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-help"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nemneshia/symbol-bootstrap.git"
  },
  "keywords": [
    "oclif"
  ],
  "scripts": {
    "doc": "typedoc --out \"ts-docs\" src && touch ./ts-docs/.nojekyll",
    "clean": "pnpm exec shx rm -rf ./lib ./target ./doc logs.log oclif.manifest.json tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "lint": "eslint --cache src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier ./src ./test",
    "format:fix": "prettier --write ./src ./test",
    "style:fix": "pnpm run create-index-files && pnpm run format:fix && pnpm run lint:fix && pnpm run oclif-doc",
    "create-index-files": "cti create ./src -b -n -e commands",
    "postpack": "pnpm exec shx rm -f oclif.manifest.json tsconfig.build.tsbuildinfo",
    "oclif-doc": "oclif manifest && oclif readme --multi",
    "oclif-debug": "env DEBUG=* oclif manifest",
    "watch": "tsc -w -p tsconfig.build.json",
    "compile": "esbuild 'src/**/*.ts' --bundle=false --format=esm --outdir=lib --platform=node --target=es2022 && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build": "pnpm run clean && pnpm run compile && oclif manifest",
    "prepack": "pnpm run build && pnpm run oclif-doc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "coveralls-report": "cat ./coverage/lcov.info | coveralls",
    "version": "echo $npm_package_version",
    "install-cli": "pnpm pack && pnpm add -g symbol-bootstrap",
    "clean-network": "symbol-bootstrap clean -t target/bootstrap-test",
    "start-network": "symbol-bootstrap start -t target/bootstrap-test -u 'current'",
    "publish:prd": "pnpm publish --access public",
    "publish:dry": "pnpm publish --access public --dry-run"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@nemnesia/symbol-openapi-typescript-fetch-client": "^1.0.1",
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.1",
    "@oclif/core": "^4.11.1",
    "@oclif/plugin-autocomplete": "^3.2.47",
    "@oclif/plugin-help": "^6.2.46",
    "archiver": "^8.0.0",
    "cfonts": "^3.3.1",
    "compare-versions": "^6.1.1",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.1",
    "node-stream-zip": "^1.15.0",
    "rxjs": "^7.8.2",
    "shx": "^0.4.0",
    "symbol-sdk": "^3.3.1",
    "tslib": "^2.8.1",
    "winston": "^3.18.3",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oclif/test": "^4.1.15",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/archiver": "^7.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.2",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.5",
    "coveralls": "^3.1.1",
    "create-ts-index": "^1.14.0",
    "dir-compare": "^5.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "mock-stdin": "^1.0.0",
    "oclif": "^4.22.50",
    "prettier": "^3.7.1",
    "tsx": "^4.0.0",
    "typedoc": "^0.28.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}