{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "module": "esnext",
    "outDir": "lib",
    "rootDir": ".",
    "strict": true,
    "target": "es2022",
    "moduleResolution": "bundler",
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ],
  "ts-node": {
    "esm": true
  }
}